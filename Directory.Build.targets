<Project>

  <!-- Metadados de projetos empacotáveis (ADR-0011).
       Vivem aqui (e não no Directory.Build.props) porque este arquivo é importado
       no FIM de cada csproj: PropertyGroups condicionais avaliam em ordem de arquivo,
       e só aqui a condição enxerga o IsPackable=true definido pelo projeto. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/rafsecco/secco-platform.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Default com respeito a valor explícito do projeto (pacotes só de conteúdo,
         como Secco.Templates, desligam símbolos) -->
    <IncludeSymbols Condition="'$(IncludeSymbols)' == ''">true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Versionamento por tag git (ADR-0011). Prefixo definido em cada projeto empacotável:
         <MinVerTagPrefix>sharedkernel/v</MinVerTagPrefix> -->
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <!-- Microsoft.SourceLink.GitHub NAO entra aqui: desde o .NET 8 o SourceLink e parte do
         SDK, e a referencia explicita so arrastava Microsoft.Build.Tasks.Git 8.0.0, que
         ganhou CVE moderada (GHSA-23fw-v26w-5fgq). Com TreatWarningsAsErrors, o NU1902
         virava ERRO em todo projeto empacotavel e travava ate o build do SharedKernel.
         As propriedades acima (PublishRepositoryUrl, EmbedUntrackedSources) sao o que o
         SourceLink do SDK consome - elas continuam valendo. Segunda vez que um pin de
         seguranca envelhece neste repositorio (a primeira foi o NU1903 do
         System.Security.Cryptography.Xml): reavaliar e manutencao, nao evento unico. -->
  </ItemGroup>

</Project>
