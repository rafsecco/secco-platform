<Project Sdk="Microsoft.NET.Sdk">

  <!-- Client NSwag (ADR-0006): GERADO no build a partir do openapi.json versionado —
       nunca editado à mão; ajustes manuais só em arquivos parciais fora da geração.
       Pacote publicável (ADR-0011): tag notificationhub-client/v -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>notificationhub-client/v</MinVerTagPrefix>
    <Description>Client HTTP gerado (NSwag) do Secco.NotificationHub — única forma de comunicação entre produtos da Secco Platform (ADR-0006).</Description>
    <PackageTags>secco;notificationhub;client;nswag</PackageTags>
    <!-- Código gerado: sem enforcement de estilo/docs -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="NSwag.ApiDescription.Client" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Client credentials (issue #25): pacote fino, sem Hangfire/JwtBearer/AspNetCore -->
    <ProjectReference Include="..\..\SDK\Secco.SDK.ClientCredentials\Secco.SDK.ClientCredentials.csproj" />
  </ItemGroup>

  <ItemGroup>
    <OpenApiReference Include="..\Secco.NotificationHub.Api\openapi\openapi.json"
                      CodeGenerator="NSwagCSharp"
                      Namespace="Secco.NotificationHub.Client"
                      ClassName="NotificationHubClient">
      <Options>/JsonLibrary:SystemTextJson /GenerateClientInterfaces:true /UseBaseUrl:false /GenerateBaseUrlProperty:false</Options>
    </OpenApiReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
