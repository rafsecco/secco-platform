@page "/tenants/{TenantId:guid}/logs"
@attribute [Authorize(Policy = AdminPortalDefaults.OperatorPolicy)]
@inject ILogQueryService LogQueryService
@inject ITenantAdminService TenantAdminService
@inject ILogger<LogViewer> Logger
@using Secco.LogStream.Client

<PageTitle>Logs — Secco AdminPortal</PageTitle>

<p><a href="@($"tenants/{TenantId}")">&larr; Voltar ao tenant</a></p>

<h1>Logs @(_tenantName is null ? "" : $"· {_tenantName}")</h1>

<div class="filters">
    <label>Nível
        <select @bind="_level">
            <option value="">Todos</option>
            @foreach (var name in Enum.GetNames<LogEntryLevel>())
            {
                <option value="@name">@name</option>
            }
        </select>
    </label>
    <label>Mensagem
        <input type="text" @bind="_message" placeholder="trecho da mensagem" />
    </label>
    <button @onclick="SearchAsync" disabled="@_busy">Buscar</button>
</div>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}
else if (_page is null)
{
    <p>Carregando…</p>
}
else if (_page.Items.Count == 0)
{
    <p>Nenhum log encontrado para os filtros.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr><th>Data</th><th>Nível</th><th>Mensagem</th><th>Correlation</th></tr>
        </thead>
        <tbody>
            @foreach (var entry in _page.Items)
            {
                <tr>
                    <td>@entry.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>@entry.Level</td>
                    <td class="msg">@entry.Message</td>
                    <td>@(entry.CorrelationId?.ToString()[..8] ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pager">
        <button @onclick="PreviousAsync" disabled="@(_busy || _page.Page <= 1)">‹ Anterior</button>
        <span>Página @_page.Page de @Math.Max(_page.TotalPages, 1) · @_page.TotalCount registros</span>
        <button @onclick="NextAsync" disabled="@(_busy || _page.Page >= _page.TotalPages)">Próxima ›</button>
    </div>
}

<section class="export">
    <h2>Exportar trilha de auditoria</h2>
    <p class="hint">Gera um arquivo com a trilha de auditoria deste tenant. A exportação fica registrada na própria trilha.</p>

    @if (ExportError is not null)
    {
        <p class="error" role="alert">@ExportMessage(ExportError)</p>
    }

    @* Formulário nativo, sem @onsubmit: o navegador baixa o arquivo. POST com antiforgery (ADR-0058). *@
    <form method="post" action="@($"tenants/{TenantId}/audit-entries/export")" class="filters" data-enhance="false">
        <AntiforgeryToken />
        <label>De <input type="datetime-local" name="From" /></label>
        <label>Até <input type="datetime-local" name="To" /></label>
        <label>Ator <input type="text" name="ActorId" maxlength="256" placeholder="sub ou client id" /></label>
        <label>Ação <input type="text" name="Action" maxlength="256" placeholder="ex.: documento.download" /></label>
        <label>Formato
            <select name="Format">
                <option value="xlsx">Excel (.xlsx)</option>
                <option value="pdf">PDF</option>
            </select>
        </label>
        <button type="submit">Exportar</button>
    </form>
</section>
@code {
    /// <summary>Tenant alvo (rota) — viaja no header X-Tenant-Id (ADR-0024).</summary>
    [Parameter] public Guid TenantId { get; set; }

    /// <summary>Código da falha da exportação, devolvido pelo endpoint de download; nunca texto livre.</summary>
    [SupplyParameterFromQuery(Name = "exportError")] public string? ExportError { get; set; }

    private static string ExportMessage(string code) => Enum.TryParse<AuditExportFailure>(code, out var failure) ? failure switch
    {
        AuditExportFailure.TooManyRows => "A exportação passa do limite de linhas. Restrinja os filtros e tente de novo.",
        AuditExportFailure.Forbidden => "Sem permissão para exportar a trilha deste tenant.",
        AuditExportFailure.RateLimited => "Exportações demais em pouco tempo. Aguarde um minuto e tente de novo.",
        AuditExportFailure.InvalidRequest => "Filtros inválidos. Confira as datas e os campos.",
        _ => "Não foi possível exportar agora. Tente novamente.",
    } : "Não foi possível exportar agora. Tente novamente.";

    private const int PageSize = 25;

    private string? _tenantName;
    private LogEntryPage? _page;
    private string? _error;
    private bool _busy;

    private string _level = string.Empty;
    private string _message = string.Empty;
    private int _pageNumber = 1;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tenantName = (await TenantAdminService.GetTenantAsync(TenantId)).Name;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Falha ao carregar o nome do tenant {TenantId}.", TenantId);
        }

        await LoadAsync();
    }

    private Task SearchAsync()
    {
        _pageNumber = 1;
        return LoadAsync();
    }

    private Task PreviousAsync()
    {
        _pageNumber = Math.Max(1, _pageNumber - 1);
        return LoadAsync();
    }

    private Task NextAsync()
    {
        _pageNumber++;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            var filter = new LogEntryFilter(
                Level: string.IsNullOrEmpty(_level) ? null : _level,
                Message: string.IsNullOrWhiteSpace(_message) ? null : _message.Trim(),
                Page: _pageNumber,
                Size: PageSize);

            _page = await LogQueryService.SearchLogEntriesAsync(TenantId, filter);
        }
        catch (ApiException exception)
        {
            _error = ApiErrorFormatter.Describe(exception.StatusCode, exception.Response);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Falha ao buscar logs do tenant {TenantId}.", TenantId);
            _error = "Não foi possível carregar os logs. Tente novamente.";
        }
        finally
        {
            _busy = false;
        }
    }
}
