@page "/tenants/{TenantId:guid}"
@attribute [Authorize(Policy = AdminPortalDefaults.OperatorPolicy)]
@inject ITenantAdminService TenantAdminService
@inject IUserAdminService UserAdminService
@inject IRoleAdminService RoleAdminService
@inject ILogger<TenantManagement> Logger
@using Secco.SecureGate.Client

<PageTitle>@(_tenant?.Name ?? "Tenant") — Secco AdminPortal</PageTitle>

<p><a href="tenants">&larr; Tenants</a></p>

@if (_loadError is not null)
{
    <p class="error" role="alert">@_loadError</p>
}
else if (_tenant is null)
{
    <p>Carregando…</p>
}
else
{
    <h1>@_tenant.Name</h1>
    <p class="muted">@_tenant.Slug · @(_tenant.IsActive ? "Ativo" : "Inativo") · <a href="@($"tenants/{TenantId}/logs")">Ver logs</a></p>

    @if (_message is not null)
    {
        <p class="success" role="status">@_message</p>
    }
    @if (_actionError is not null)
    {
        <p class="error" role="alert">@_actionError</p>
    }
    @if (_cleanup is not null)
    {
        <div class="form-card" role="status">
            <p>@_cleanup.PermissionsRemoved permissão(ões) órfã(s) removida(s) de @_cleanup.RolesChanged perfil(is).</p>
            @if (_cleanup.Roles.Count > 0)
            {
                <ul>
                    @foreach (var role in _cleanup.Roles)
                    {
                        <li>@role.Role: @string.Join(", ", role.Removed)</li>
                    }
                </ul>
            }
        </div>
    }
    @if (_confirmCleanup)
    {
        <div class="form-card" role="alertdialog">
            <p>Remover de todos os perfis deste tenant as permissões que nenhum produto declara? Esta ação não pode ser desfeita.</p>
            <button @onclick="CleanupOrphansAsync" disabled="@_busy">Confirmar</button>
            <button @onclick="() => _confirmCleanup = false" disabled="@_busy">Cancelar</button>
        </div>
    }

    <section>
        <h2>Usuários</h2>
        @if (_users is null)
        {
            <p>Carregando…</p>
        }
        else if (_users.Count == 0)
        {
            <p>Nenhum usuário cadastrado.</p>
        }
        else
        {
            <table class="grid">
                <thead><tr><th>E-mail</th><th>Vínculo</th><th>Situação</th><th>Perfis</th></tr></thead>
                <tbody>
                    @foreach (var user in _users)
                    {
                        <tr>
                            <td><a href="@($"tenants/{TenantId}/users/{user.Id}")">@user.Email</a></td>
                            <td>@MembershipText.Describe(user.Membership)</td>
                            <td>@UserStatusText.Describe(user.Status)</td>
                            <td>@(user.Roles.Count == 0 ? "—" : string.Join(", ", user.Roles))</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="form-card">
            <h3>Novo usuário</h3>
            <label>E-mail<input type="email" @bind="_newUserEmail" autocomplete="off" /></label>
            @* ADR-0033: o operador não escolhe senha de ninguém — ou a pessoa recebe convite,
               ou a conta entra só pelo diretório corporativo. *@
            <label>Acesso
                <select @bind="_newUserLocalLogin">
                    <option value="true">Com senha local (envia convite por e-mail)</option>
                    <option value="false">Só login corporativo (Entra ID)</option>
                </select>
            </label>
            @if (_roles is { Count: > 0 })
            {
                <fieldset>
                    <legend>Perfis</legend>
                    @foreach (var role in _roles)
                    {
                        <label>
                            <input type="checkbox"
                                   checked="@_newUserRoles.Contains(role.Name)"
                                   @onchange="e => ToggleNewUserRole(role.Name, e)" />
                            @role.Name
                        </label>
                    }
                </fieldset>
            }
            <button @onclick="CreateUserAsync" disabled="@_busy">Criar usuário</button>
        </div>
    </section>

    <section>
        <h2>Membros</h2>
        <p class="muted">
            Pessoas cuja conta pertence a outro tenant e que também têm acesso a este (ADR-0040).
            Perfis e histórico de acesso valem por tenant; a conta, a senha e o segundo fator seguem no tenant dono.
        </p>
        @if (_pendingMember is not null)
        {
            <div class="form-card" role="alertdialog">
                <p>@_pendingMember.Message</p>
                <button @onclick="ConfirmMemberAsync" disabled="@_busy">Confirmar</button>
                <button @onclick="() => _pendingMember = null" disabled="@_busy">Cancelar</button>
            </div>
        }
        @if (_users is null)
        {
            <p>Carregando…</p>
        }
        else if (Members.Count == 0)
        {
            <p>Nenhum membro de outro tenant.</p>
        }
        else
        {
            <table class="grid">
                <thead><tr><th>E-mail</th><th>Vínculo</th><th>Tenant dono</th><th></th></tr></thead>
                <tbody>
                    @foreach (var member in Members)
                    {
                        <tr>
                            <td><a href="@($"tenants/{TenantId}/users/{member.Id}")">@member.Email</a></td>
                            <td>@MembershipText.Describe(member.Membership)</td>
                            <td class="muted">@(member.OwnerTenantId?.ToString() ?? "—")</td>
                            <td>
                                @if (member.Membership == MembershipText.Suspended)
                                {
                                    <button @onclick="() => ReactivateMemberAsync(member)" disabled="@_busy">Reativar</button>
                                }
                                else
                                {
                                    <button @onclick="() => AskSuspendMember(member)" disabled="@_busy">Suspender</button>
                                }
                                <button @onclick="() => AskRemoveMember(member)" disabled="@_busy">Remover</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="form-card">
            <h3>Incluir membro</h3>
            <label>E-mail de uma conta existente<input type="email" @bind="_newMemberEmail" autocomplete="off" /></label>
            <button @onclick="AddMemberAsync" disabled="@_busy">Incluir membro</button>
        </div>
    </section>

    <section>
        <h2>Admins do tenant</h2>
        <p class="muted">
            Pessoas que administram este tenant por uma aplicação de plataforma, on-behalf-of si mesmas (ADR-0044):
            pessoas, vínculos e perfis daqui, com cada escrita registrada na trilha deste tenant. A pessoa pode ser
            de qualquer tenant. Para conceder, abra a página da pessoa no tenant dono dela.
        </p>
        @if (_pendingAdmin is not null)
        {
            <div class="form-card" role="alertdialog">
                <p>@_pendingAdmin.Message</p>
                <button @onclick="ConfirmAdminAsync" disabled="@_busy">Confirmar</button>
                <button @onclick="() => _pendingAdmin = null" disabled="@_busy">Cancelar</button>
            </div>
        }
        @if (_adminsError is not null)
        {
            <p class="error" role="alert">@_adminsError</p>
        }
        else if (_admins is null)
        {
            <p>Carregando…</p>
        }
        else if (_admins.Count == 0)
        {
            <p>Nenhuma pessoa administra este tenant.</p>
        }
        else
        {
            <table class="grid">
                <thead><tr><th>Pessoa</th><th>Tenant dono</th><th>Concedido em</th><th></th></tr></thead>
                <tbody>
                    @foreach (var admin in _admins)
                    {
                        <tr>
                            <td><a href="@($"tenants/{admin.OwnerTenantId}/users/{admin.UserId}")">@(admin.DisplayName ?? admin.Email)</a></td>
                            <td class="muted">@(admin.OwnerTenantId == TenantId ? "este" : admin.OwnerTenantId.ToString())</td>
                            <td>@admin.GrantedAt.ToLocalTime().ToString("g")</td>
                            <td><button @onclick="() => AskRevokeAdmin(admin)" disabled="@_busy">Revogar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>Trilha</h2>
        <p class="muted">
            O que as aplicações com gestão do próprio tenant (<code>securegate:tenant-manage</code>) escreveram neste
            tenant, registrado pelo SecureGate antes de cada operação (ADR-0054). Só o operador lê.
        </p>
        @if (_trailError is not null)
        {
            <p class="error" role="alert">@_trailError</p>
        }
        else if (_trail is null)
        {
            <p>Carregando…</p>
        }
        else if (_trail.Items.Count == 0)
        {
            <p>Nenhuma operação registrada.</p>
        }
        else
        {
            <table class="grid">
                <thead><tr><th>Quando</th><th>Aplicação</th><th>Operação</th><th>Recurso</th></tr></thead>
                <tbody>
                    @foreach (var entry in _trail.Items)
                    {
                        <tr>
                            <td>@entry.OccurredAt.ToLocalTime().ToString("g")</td>
                            <td>@entry.ActorId</td>
                            <td>@entry.Action</td>
                            <td class="muted">@entry.ResourceType @entry.ResourceId</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="pager">
                <button @onclick="PreviousTrailAsync" disabled="@(_busy || _trail.Page <= 1)">‹ Anterior</button>
                <span>Página @_trail.Page de @Math.Max(_trail.TotalPages, 1) · @_trail.TotalCount registros</span>
                <button @onclick="NextTrailAsync" disabled="@(_busy || _trail.Page >= _trail.TotalPages)">Próxima ›</button>
            </div>
        }
    </section>

    <section>
        <h2>Perfis</h2>
        @if (_roles is null)
        {
            <p>Carregando…</p>
        }
        else if (_roles.Count == 0)
        {
            <p>Nenhum perfil cadastrado.</p>
        }
        else
        {
            <table class="grid">
                <thead><tr><th>Perfil</th><th>Permissões</th></tr></thead>
                <tbody>
                    @foreach (var role in _roles)
                    {
                        <tr>
                            <td><a href="@($"tenants/{TenantId}/roles/{Uri.EscapeDataString(role.Name)}")">@role.Name</a></td>
                            <td>@role.Permissions.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <p>
            <button @onclick="AskCleanup" disabled="@(_busy || _confirmCleanup)">Remover permissões órfãs</button>
        </p>

        <div class="form-card">
            <h3>Novo perfil</h3>
            <label>Nome<input type="text" @bind="_newRoleName" placeholder="ex.: financeiro-user" /></label>
            <button @onclick="CreateRoleAsync" disabled="@_busy">Criar perfil</button>
        </div>
    </section>

    <section>
        <h2>Bancos de tenant</h2>
        @if (_tenant.Products.Count == 0)
        {
            <p>Nenhum banco cadastrado.</p>
        }
        else
        {
            <table class="grid">
                <thead><tr><th>Produto</th><th>Banco</th></tr></thead>
                <tbody>
                    @foreach (var product in _tenant.Products)
                    {
                        <tr>
                            <td>@product</td>
                            <td class="muted">cadastrado</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="form-card">
            <h3>Cadastrar / rotacionar banco</h3>
            <label>Produto<input type="text" @bind="_newDbProduct" placeholder="ex.: logstream" /></label>
            <label>Connection string (write-only)<input type="password" @bind="_newDbConnectionString" autocomplete="off" /></label>
            <button @onclick="UpsertDatabaseAsync" disabled="@_busy">Salvar banco</button>
        </div>
    </section>

    @* Federação é só do operador (ADR-0026, ADR-0052): o admin de tenant não tem esta rota. *@
    <section>
        <h2>Federação (Entra ID)</h2>
        @if (_tenant.Federation is null)
        {
            <p>Nenhuma federação configurada.</p>
        }
        else
        {
            <dl>
                <dt>Directory id</dt><dd>@_tenant.Federation.DirectoryId</dd>
                <dt>Situação</dt><dd>@(_tenant.Federation.IsEnabled ? "Habilitada" : "Desabilitada")</dd>
                <dt>Atualizada em</dt><dd>@(_tenant.Federation.UpdatedAt?.ToString("g") ?? "-")</dd>
            </dl>
        }

        <div class="form-card">
            <h3>Configurar federação</h3>
            <label>Directory id (tid)<input type="text" @bind="_federationDirectoryId" autocomplete="off" /></label>
            <label><input type="checkbox" @bind="_federationEnabled" /> Habilitada</label>
            <button @onclick="SaveFederationAsync" disabled="@_busy">Salvar federação</button>
        </div>
    </section>
}

@code {
    /// <summary>Tenant alvo (rota).</summary>
    [Parameter] public Guid TenantId { get; set; }

    private TenantDetail? _tenant;
    private IReadOnlyList<TenantAdminSummary>? _admins;
    private string? _adminsError;
    private const int TrailPageSize = 25;
    private AuthorityTrailPage? _trail;
    private string? _trailError;
    private int _trailPage = 1;
    private PendingMemberAction? _pendingAdmin;
    private IReadOnlyList<UserSummary>? _users;
    private IReadOnlyList<RoleSummary>? _roles;

    private string? _loadError;
    private string? _actionError;
    private string? _message;
    private bool _busy;
    private bool _confirmCleanup;
    private RemovedUnknownPermissionsSummary? _cleanup;

    private string _newMemberEmail = string.Empty;
    private PendingMemberAction? _pendingMember;
    private string _newUserEmail = string.Empty;
    private bool _newUserLocalLogin = true;
    private readonly HashSet<string> _newUserRoles = new(StringComparer.Ordinal);
    private string _newRoleName = string.Empty;
    private string _newDbProduct = string.Empty;
    private string _newDbConnectionString = string.Empty;
    private string _federationDirectoryId = string.Empty;
    private bool _federationEnabled = true;

    private sealed record PendingMemberAction(string Message, Func<Task> Action);

    private IReadOnlyList<UserSummary> Members =>
        _users is null ? [] : [.. _users.Where(user => user.Membership != MembershipText.Owner)];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tenant = await TenantAdminService.GetTenantAsync(TenantId);
            await ReloadUsersAsync();
            await ReloadRolesAsync();
            await ReloadAdminsAsync();
            await ReloadTrailAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Falha ao carregar o tenant {TenantId}.", TenantId);
            _loadError = "Não foi possível carregar o tenant.";
        }
    }

    private async Task ReloadUsersAsync() => _users = await UserAdminService.ListUsersAsync(TenantId);

    private async Task ReloadRolesAsync() => _roles = await RoleAdminService.ListRolesAsync(TenantId);

    // Seção à parte: um SecureGate anterior à ADR-0044 não tem a rota, e isso não derruba a página
    private async Task ReloadAdminsAsync()
    {
        try
        {
            _admins = await TenantAdminService.ListAdminsAsync(TenantId);
            _adminsError = null;
        }
        catch (ApiException exception)
        {
            _adminsError = ApiErrorFormatter.Describe(exception.StatusCode, exception.Response);
        }
    }

    // Seção à parte, como a dos admins: a trilha falhar não derruba a página do tenant
    private async Task ReloadTrailAsync()
    {
        try
        {
            _trail = await TenantAdminService.ListAuthorityTrailAsync(TenantId, _trailPage, TrailPageSize);
            _trailError = null;
        }
        catch (ApiException exception)
        {
            _trailError = ApiErrorFormatter.Describe(exception.StatusCode, exception.Response);
        }
    }

    private Task PreviousTrailAsync()
    {
        _trailPage = Math.Max(1, _trailPage - 1);

        return ReloadTrailAsync();
    }

    private Task NextTrailAsync()
    {
        _trailPage++;

        return ReloadTrailAsync();
    }

    private void AskRevokeAdmin(TenantAdminSummary admin) =>
        _pendingAdmin = new PendingMemberAction(
            $"Revogar a autoridade de {admin.Email} sobre este tenant? Vale na próxima requisição da pessoa; conta, vínculos e perfis não mudam.",
            async () =>
            {
                await TenantAdminService.RevokeAdminAsync(TenantId, admin.UserId);
                await ReloadAdminsAsync();
                _message = $"{admin.Email} não administra mais este tenant.";
            });

    private async Task ConfirmAdminAsync()
    {
        var pending = _pendingAdmin;
        _pendingAdmin = null;

        if (pending is not null)
        {
            await RunAsync(pending.Action);
        }
    }

    private void ToggleNewUserRole(string role, ChangeEventArgs change)
    {
        if (change.Value is true)
        {
            _newUserRoles.Add(role);
        }
        else
        {
            _newUserRoles.Remove(role);
        }
    }

    private async Task CreateUserAsync()
    {
        if (string.IsNullOrWhiteSpace(_newUserEmail))
        {
            SetError("Informe o e-mail.");
            return;
        }

        await RunAsync(async () =>
        {
            var email = _newUserEmail.Trim();
            await UserAdminService.CreateUserAsync(TenantId, email, _newUserLocalLogin, [.. _newUserRoles]);
            _newUserEmail = string.Empty;
            _newUserRoles.Clear();
            var localLogin = _newUserLocalLogin;
            _newUserLocalLogin = true;
            await ReloadUsersAsync();
            _message = localLogin
                ? $"Usuário criado. Convite enviado para {email}."
                : "Usuário criado. O acesso é pelo diretório corporativo.";
        });
    }

    private async Task AddMemberAsync()
    {
        if (string.IsNullOrWhiteSpace(_newMemberEmail))
        {
            SetError("Informe o e-mail.");
            return;
        }

        await RunAsync(async () =>
        {
            var email = _newMemberEmail.Trim();
            await UserAdminService.AddMemberAsync(TenantId, email);
            _newMemberEmail = string.Empty;
            await ReloadUsersAsync();
            _message = $"{email} incluído como membro. Atribua um perfil para liberar acesso.";
        });
    }

    private Task ReactivateMemberAsync(UserSummary member) => RunAsync(async () =>
    {
        await UserAdminService.ReactivateMemberAsync(TenantId, member.Id);
        await ReloadUsersAsync();
        _message = $"Vínculo de {member.Email} reativado.";
    });

    private void AskSuspendMember(UserSummary member) =>
        _pendingMember = new PendingMemberAction(
            $"Suspender {member.Email} neste tenant? As sessões da pessoa em todos os sistemas são encerradas; perfis e histórico ficam preservados.",
            async () =>
            {
                await UserAdminService.SuspendMemberAsync(TenantId, member.Id);
                await ReloadUsersAsync();
                _message = $"Vínculo de {member.Email} suspenso. As sessões da pessoa foram encerradas.";
            });

    private void AskRemoveMember(UserSummary member) =>
        _pendingMember = new PendingMemberAction(
            $"Remover {member.Email} deste tenant? Os perfis dela aqui são apagados e as sessões da pessoa em todos os sistemas são encerradas.",
            async () =>
            {
                await UserAdminService.RemoveMemberAsync(TenantId, member.Id);
                await ReloadUsersAsync();
                _message = $"{member.Email} removido do tenant. As sessões da pessoa foram encerradas.";
            });

    private async Task ConfirmMemberAsync()
    {
        var pending = _pendingMember;
        _pendingMember = null;

        if (pending is not null)
        {
            await RunAsync(pending.Action);
        }
    }

    private async Task CreateRoleAsync()
    {
        if (string.IsNullOrWhiteSpace(_newRoleName))
        {
            SetError("Informe o nome do perfil.");
            return;
        }

        await RunAsync(async () =>
        {
            await RoleAdminService.CreateRoleAsync(TenantId, _newRoleName.Trim());
            _newRoleName = string.Empty;
            await ReloadRolesAsync();
            _message = "Perfil criado.";
        });
    }

    private void AskCleanup()
    {
        _confirmCleanup = true;
        _cleanup = null;
    }

    private async Task CleanupOrphansAsync()
    {
        _confirmCleanup = false;

        await RunAsync(async () =>
        {
            _cleanup = await RoleAdminService.RemoveUnknownPermissionsAsync(TenantId);
            await ReloadRolesAsync();
        });
    }

    private async Task UpsertDatabaseAsync()
    {
        if (string.IsNullOrWhiteSpace(_newDbProduct) || string.IsNullOrWhiteSpace(_newDbConnectionString))
        {
            SetError("Informe o produto e a connection string.");
            return;
        }

        await RunAsync(async () =>
        {
            await TenantAdminService.UpsertDatabaseAsync(
                TenantId, _newDbProduct.Trim().ToLowerInvariant(), _newDbConnectionString);
            _newDbProduct = _newDbConnectionString = string.Empty;
            _tenant = await TenantAdminService.GetTenantAsync(TenantId); // atualiza os Products
            _message = "Banco salvo.";
        });
    }

    private async Task SaveFederationAsync()
    {
        if (!Guid.TryParse(_federationDirectoryId?.Trim(), out var directoryId) || directoryId == Guid.Empty)
        {
            SetError("Informe um directory id válido (GUID).");
            return;
        }

        await RunAsync(async () =>
        {
            await TenantAdminService.SetFederationAsync(TenantId, directoryId, _federationEnabled);
            _tenant = await TenantAdminService.GetTenantAsync(TenantId);
            _message = "Federação salva.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _actionError = _message = null;
        try
        {
            await action();
        }
        catch (ApiException exception)
        {
            _actionError = ApiErrorFormatter.Describe(exception.StatusCode, exception.Response);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Falha na operação de gestão do tenant {TenantId}.", TenantId);
            _actionError = "Falha inesperada. Tente novamente.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void SetError(string message)
    {
        _actionError = message;
        _message = null;
    }
}
