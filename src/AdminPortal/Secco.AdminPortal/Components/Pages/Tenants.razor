@page "/tenants"
@attribute [Authorize(Policy = AdminPortalDefaults.OperatorPolicy)]
@inject ITenantAdminService TenantAdminService
@inject NavigationManager Navigation
@inject ILogger<Tenants> Logger
@using Secco.SecureGate.Client

<PageTitle>Tenants — Secco AdminPortal</PageTitle>

<h1>Tenants</h1>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}
else if (_tenants is null)
{
    <p>Carregando…</p>
}
else if (_tenants.Count == 0)
{
    <p>Nenhum tenant cadastrado.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Slug</th>
                <th>Situação</th>
                <th>Criado em</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tenant in _tenants)
            {
                <tr>
                    <td>@tenant.Name</td>
                    <td>@tenant.Slug</td>
                    <td>@(tenant.IsActive ? "Ativo" : "Inativo")</td>
                    <td>@tenant.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td><a href="@($"tenants/{tenant.Id}")">Gerir identidade</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_tenants is not null)
{
    @* ADR-0051: criar tenant é do operador, por aqui. Nasce ativo e sem bancos; perfis, pessoas e
       bancos se configuram na página do tenant, para onde a criação leva. *@
    <div class="form-card">
        <h3>Novo tenant</h3>
        @if (_createError is not null)
        {
            <p class="error" role="alert">@_createError</p>
        }
        <label>Nome<input type="text" @bind="_newName" placeholder="ex.: Compras" /></label>
        <label>Slug<input type="text" @bind="_newSlug" placeholder="ex.: compras" autocomplete="off" /></label>
        <button @onclick="CreateTenantAsync" disabled="@_busy">Criar tenant</button>
    </div>
}

@code {
    private IReadOnlyList<TenantSummary>? _tenants;
    private string? _error;
    private string? _createError;
    private string _newName = string.Empty;
    private string _newSlug = string.Empty;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tenants = await TenantAdminService.ListTenantsAsync();
        }
        catch (Exception exception)
        {
            // O detalhe fica no log; o usuário vê mensagem genérica (ADR-0020)
            Logger.LogError(exception, "Falha ao listar tenants no SecureGate.");
            _error = "Não foi possível carregar os tenants. Tente novamente.";
        }
    }

    private async Task CreateTenantAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newSlug))
        {
            _createError = "Informe o nome e o slug.";
            return;
        }

        _busy = true;
        _createError = null;
        try
        {
            var tenant = await TenantAdminService.CreateTenantAsync(_newName.Trim(), _newSlug.Trim());
            Navigation.NavigateTo($"tenants/{tenant.Id}");
        }
        catch (ApiException exception)
        {
            // Nome/slug inválido (400) ou slug em uso (409): a mensagem do SecureGate diz qual
            _createError = ApiErrorFormatter.Describe(exception.StatusCode, exception.Response);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Falha ao criar tenant no SecureGate.");
            _createError = "Falha inesperada. Tente novamente.";
        }
        finally
        {
            _busy = false;
        }
    }
}
