@page
@model LoginModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Entrar";
}

<h1>Secco SecureGate</h1>
<p class="sub">Entre com suas credenciais para continuar.</p>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
    <label asp-for="Input.Email">E-mail</label>
    <input asp-for="Input.Email" type="email" autocomplete="username" autofocus />
    <span class="field-error" asp-validation-for="Input.Email"></span>

    <label asp-for="Input.Password">Senha</label>
    <input asp-for="Input.Password" type="password" autocomplete="current-password" />
    <span class="field-error" asp-validation-for="Input.Password"></span>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error" role="alert">@Model.ErrorMessage</div>
    }

    <button type="submit">Entrar</button>
</form>

@* Recuperação de conta (ADR-0033): qualquer pessoa pede, sem depender de admin *@
<p style="margin-top:1rem"><a href="/conta/esqueci">Esqueci minha senha</a></p>

@if (Model.EntraEnabled)
{
    <div class="divider">ou</div>

    @* Login federado (ADR-0026): desafia o Entra ID; o callback decide fail-closed *@
    <form method="post" asp-page-handler="Entra" asp-route-returnUrl="@Model.ReturnUrl">
        <button type="submit" class="secondary">Entrar com conta Microsoft</button>
    </form>
}
