@page "/conta/trocar-senha"
@model Secco.SecureGate.Api.Pages.Account.ChangePasswordModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Trocar senha";
}

<h1>Trocar minha senha</h1>

@if (Model.Changed)
{
    <p class="sub">Senha alterada. As outras sessões desta conta foram encerradas.</p>
    <p style="margin-top:1rem"><a href="/login">Voltar</a></p>
}
else
{
    <p class="sub">Informe a senha atual e escolha a nova. As outras sessões serão encerradas.</p>

    <form method="post" novalidate>
        <label asp-for="Input.CurrentPassword">Senha atual</label>
        <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" autofocus />
        <span class="field-error" asp-validation-for="Input.CurrentPassword"></span>

        <label asp-for="Input.Password">Nova senha</label>
        <input asp-for="Input.Password" type="password" autocomplete="new-password" />
        <span class="field-error" asp-validation-for="Input.Password"></span>

        <label asp-for="Input.ConfirmPassword">Confirme a nova senha</label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
        <span class="field-error" asp-validation-for="Input.ConfirmPassword"></span>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error" role="alert">@Model.ErrorMessage</div>
        }

        <button type="submit">Trocar senha</button>
    </form>
}
