@page "/conta"
@model Secco.SecureGate.Api.Pages.Account.IndexModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Minha conta";
}

<h1>Minha conta</h1>
<p class="sub">@Model.Email</p>

@if (Model.PasswordChanged)
{
    <div class="notice" role="status">Senha alterada. As outras sessões desta conta foram encerradas.</div>
}

@if (Model.UsesLocalPassword)
{
    <p style="margin-top:1rem"><a href="/conta/trocar-senha">Trocar minha senha</a></p>
}
else
{
    <p class="sub" style="margin-top:1rem">Esta conta entra pelo diretório corporativo e não usa senha local.</p>
}

@* Fora do ramo acima de propósito: conta de diretório também troca o e-mail — nela não há
   senha a exigir, e o login já é governado pelo vínculo com o diretório (ADR-0026). *@
<p><a href="/conta/trocar-email">Trocar meu e-mail</a></p>

@if (Model.UsesLocalPassword)
{
    @* Segundo fator protege a SENHA: conta de diretório não tem o que proteger aqui, porque o
       MFA é do próprio diretório (ADR-0026). *@
    <p><a href="/conta/dois-fatores">Segundo fator (@(Model.TwoFactorEnabled ? "ativado" : "desativado"))</a></p>
}

<form method="post" asp-page-handler="Logout">
    <button type="submit" class="secondary">Sair</button>
</form>
