@page "/conta/redefinir-senha"
@model Secco.SecureGate.Api.Pages.Account.ResetPasswordModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Redefinir senha";
}

<h1>Escolha uma nova senha</h1>

@if (Model.LinkRejected)
{
    <p class="sub">Este link não vale mais: ele expirou, já foi usado ou a conta mudou de estado.</p>
    <div class="notice" role="alert">
        Você pode <a href="/conta/esqueci">pedir outro link</a> a qualquer momento.
    </div>
}
else
{
    <p class="sub">Ao concluir, todas as sessões abertas desta conta serão encerradas.</p>

    <form method="post" novalidate>
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />

        <label asp-for="Input.Password">Nova senha</label>
        <input asp-for="Input.Password" type="password" autocomplete="new-password" autofocus />
        <span class="field-error" asp-validation-for="Input.Password"></span>

        <label asp-for="Input.ConfirmPassword">Confirme a senha</label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
        <span class="field-error" asp-validation-for="Input.ConfirmPassword"></span>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error" role="alert">@Model.ErrorMessage</div>
        }

        <button type="submit">Redefinir senha</button>
    </form>
}
