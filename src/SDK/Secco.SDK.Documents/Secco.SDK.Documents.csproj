<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pacote publicável (ADR-0011): versão via tag git com prefixo sdk-documents/v -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>sdk-documents/v</MinVerTagPrefix>
    <Description>Exportação de listagens em Excel (.xlsx) e PDF tabular gerada no servidor (ADR-0058): gravadores próprios com memória constante e sem dependência de terceiros, nenhuma célula vira fórmula, limite de linhas, concorrência limitada, arquivo temporário protegido e resposta HTTP com Content-Disposition seguro.</Description>
    <PackageTags>secco;sdk;export;xlsx;excel;pdf</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- ADR-0058: nenhuma biblioteca de terceiros. O FrameworkReference serve ao helper de resposta HTTP. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SharedKernel\Secco.SharedKernel\Secco.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Secco.SDK.Documents.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
