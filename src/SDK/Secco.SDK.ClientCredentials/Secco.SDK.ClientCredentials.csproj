<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pacote publicável (ADR-0011): versão via tag git com prefixo sdk-credentials/v -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>sdk-credentials/v</MinVerTagPrefix>
    <Description>Client credentials OAuth2 para clients de produto (Secco.&lt;Produto&gt;.Client) autenticarem chamadas de máquina a máquina contra o SecureGate. Pacote fino de propósito: só Microsoft.Extensions.Http e DI/Configuration, sem Hangfire/JwtBearer/AspNetCore do Secco.SDK.AspNetCore.</Description>
    <PackageTags>secco;sdk;oauth;client-credentials</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
