# Secco Platform — variáveis do deploy/docker-compose.yml (guia: docs/guia-de-implantacao.md).
# Copie para .env e preencha. O .env real nunca entra no git.
# Segredos: gere com `openssl rand -hex 32` (hex não tem ; # $ nem espaço, que quebrariam
# a connection string ou o parser). Valores com esses caracteres vão entre aspas simples.

# Versão das imagens: sempre uma tag fixa X.Y.Z, nunca latest
SECCO_VERSION=0.1.0
SECCO_REGISTRY=ghcr.io/rafsecco

# Domínios públicos (um por serviço), atendidos pelo proxy
SECUREGATE_HOST=login.exemplo.com.br
LOGSTREAM_HOST=logs.exemplo.com.br
NOTIFICATIONHUB_HOST=notificacoes.exemplo.com.br
ADMINPORTAL_HOST=admin.exemplo.com.br

# Rede interna do compose: a única origem aceita para X-Forwarded-*. O nome é o que um produto
# adotante no mesmo host (ex.: a Intranet) referencia como rede externa
SECCO_NETWORK_NAME=secco
SECCO_NETWORK_SUBNET=172.30.0.0/24
HTTPS_PORT=443
HTTP_PORT=80

# Banco externo (SQL Server). Bancos e logins vêm do deploy/sql/sqlserver-plataforma.sql
DB_SERVER=sql.exemplo.com.br,1433
DB_TRUST_SERVER_CERTIFICATE=false
SECUREGATE_DB_MIGRATOR_PASSWORD=
SECUREGATE_DB_APP_PASSWORD=
NOTIFICATIONHUB_JOBS_MIGRATOR_PASSWORD=
NOTIFICATIONHUB_JOBS_APP_PASSWORD=

# SecureGate: chave do catálogo (base64 de 32 bytes: `openssl rand -base64 32`) e certificado
SECUREGATE_CATALOG_KEY=
SECUREGATE_SIGNING_CERT_FILE=./secrets/securegate-signing.pfx
SECUREGATE_SIGNING_PASSWORD=

# Segredos dos clients de plataforma (ao menos 32 caracteres)
LOGSTREAM_CLIENT_SECRET=
NOTIFICATIONHUB_CLIENT_SECRET=
ADMINPORTAL_CLIENT_SECRET=
ADMINPORTAL_SESSIONS_CLIENT_SECRET=

# SMTP do convite, da recuperação de senha e das notificações por e-mail
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=nao-responda@exemplo.com.br
SMTP_FROM_NAME=Login
